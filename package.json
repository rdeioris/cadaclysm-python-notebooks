{
  "name": "cadaclysm-python-notebooks",
  "version": "0.1.0",
  "description": "A Python notebook in the browser on the cadaclysm CAD kernel: the SDK's cadaclysm_blacksmith module under Pyodide, every solid drawn in its cell.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "repository": "github:rdeioris/cadaclysm-python-notebooks",
  "homepage": "https://cadaclysm.blitter.studio/",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "esbuild editor.js --bundle --format=esm --minify --metafile=vendor/editor.meta.json --outfile=vendor/editor.js",
    "licences": "node scripts/third-party.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node test/run.mjs",
    "test:browser": "node test/browser.mjs"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.5",
    "@codemirror/view": "6.43.12",
    "@lezer/highlight": "1.2.3",
    "esbuild": "0.28.2",
    "fflate": "0.8.2",
    "pyodide": "314.0.7"
  }
}
